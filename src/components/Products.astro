---
import '../styles/products.css';
---

<section class="section products" id="productos">
  <div class="container">
    <h2 class="section-title">Box de este mes</h2>
    <p class="section-subtitle">Ruta del Litoral — una selección especial de productos del litoral argentino.</p>
    <div class="products-grid">
      <div class="product-card">
        <div class="product-img" aria-hidden="true">
          <i class="fas fa-drumstick-bite"></i>
        </div>
        <span class="product-tag">Salame de Tandil</span>
      </div>
      <div class="product-card">
        <div class="product-img" aria-hidden="true">
          <i class="fas fa-cheese"></i>
        </div>
        <span class="product-tag">Provoleta ahumada</span>
      </div>
      <div class="product-card">
        <div class="product-img" aria-hidden="true">
          <i class="fas fa-cheese"></i>
        </div>
        <span class="product-tag">Queso de cabra patagónico</span>
      </div>
      <div class="product-card">
        <div class="product-img" aria-hidden="true">
          <i class="fas fa-drumstick-bite"></i>
        </div>
        <span class="product-tag">Bondiola curada</span>
      </div>
      <div class="product-card">
        <div class="product-img" aria-hidden="true">
          <i class="fas fa-drumstick-bite"></i>
        </div>
        <span class="product-tag">Mortadela artesanal</span>
      </div>
      <div class="product-card">
        <div class="product-img" aria-hidden="true">
          <i class="fas fa-cheese"></i>
        </div>
        <span class="product-tag">Camembert criollo</span>
      </div>
      <div class="product-card">
        <div class="product-img" aria-hidden="true">
          <i class="fas fa-jar"></i>
        </div>
        <span class="product-tag">Picadillo de campo</span>
      </div>
      <div class="product-card">
        <div class="product-img" aria-hidden="true">
          <i class="fas fa-cheese"></i>
        </div>
        <span class="product-tag">Brie con hierbas</span>
      </div>
      <div class="product-card">
        <div class="product-img" aria-hidden="true">
          <i class="fas fa-drumstick-bite"></i>
        </div>
        <span class="product-tag">Jamón crudo de altura</span>
      </div>
    </div>
  </div>
</section>
