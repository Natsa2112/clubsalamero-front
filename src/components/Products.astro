---
import '../styles/products.css';

interface Product {
  name: string;
  category: 'Embutidos' | 'Quesos' | 'Acompañamientos';
  origin: string;
  icon: string;
  description?: string;
  featured?: boolean;
}

const products: Product[] = [
  {
    name: 'Salame de Tandil',
    category: 'Embutidos',
    origin: 'Tandil, Buenos Aires',
    icon: 'fa-drumstick-bite',
    featured: true,
    description:
      'El clásico de la casa. Curado lentamente con receta familiar que pasa de generación en generación. Ahumado en leña de quebracho.',
  },
  {
    name: 'Provoleta ahumada',
    category: 'Quesos',
    origin: 'Villa General Belgrano, Córdoba',
    icon: 'fa-cheese',
  },
  {
    name: 'Queso de cabra patagónico',
    category: 'Quesos',
    origin: 'Trevelin, Chubut',
    icon: 'fa-cheese',
  },
  {
    name: 'Bondiola curada',
    category: 'Embutidos',
    origin: 'Mendoza',
    icon: 'fa-drumstick-bite',
  },
  {
    name: 'Mortadela artesanal',
    category: 'Embutidos',
    origin: 'Mercedes, Buenos Aires',
    icon: 'fa-drumstick-bite',
  },
  {
    name: 'Camembert criollo',
    category: 'Quesos',
    origin: 'Suipacha, Buenos Aires',
    icon: 'fa-cheese',
  },
  {
    name: 'Picadillo de campo',
    category: 'Acompañamientos',
    origin: 'Concordia, Entre Ríos',
    icon: 'fa-jar',
  },
  {
    name: 'Brie con hierbas',
    category: 'Quesos',
    origin: 'Tandil, Buenos Aires',
    icon: 'fa-cheese',
  },
  {
    name: 'Jamón crudo de altura',
    category: 'Embutidos',
    origin: 'Humahuaca, Jujuy',
    icon: 'fa-drumstick-bite',
  },
];

const slug = (s: string) =>
  s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(' ', '');

const featured = products.find(p => p.featured)!;
const others = products.filter(p => !p.featured);
---

<section class="section products" id="productos">
  <div class="container">
    <header class="products-header">
      <span class="products-eyebrow">
        <i class="fas fa-gift" aria-hidden="true"></i> Box del mes · {products.length} productos
      </span>
      <h2 class="section-title">Ruta del Litoral</h2>
      <p class="section-subtitle">
        Una selección especial que recorre el litoral argentino. Cada pieza cuenta la historia de su productor.
      </p>
    </header>

    <div class="products-bento">
      <article class="product-card product-card--featured">
        <div class={`product-visual product-visual--${slug(featured.category)}`}>
          <i class={`fas ${featured.icon}`} aria-hidden="true"></i>
        </div>
        <div class="product-info">
          <div class="product-meta">
            <span class={`product-category product-category--${slug(featured.category)}`}>
              {featured.category}
            </span>
            <span class="product-featured-tag" aria-label="Producto destacado del mes">
              <i class="fas fa-star" aria-hidden="true"></i> Destacado
            </span>
          </div>
          <h3 class="product-name">{featured.name}</h3>
          <p class="product-description">{featured.description}</p>
          <span class="product-origin">
            <i class="fas fa-location-dot" aria-hidden="true"></i> {featured.origin}
          </span>
        </div>
      </article>

      <div class="product-list" role="list">
        {others.map(product => (
          <article class="product-card" role="listitem">
            <div class={`product-visual product-visual--${slug(product.category)}`}>
              <i class={`fas ${product.icon}`} aria-hidden="true"></i>
            </div>
            <div class="product-info">
              <span class={`product-category product-category--${slug(product.category)}`}>
                {product.category}
              </span>
              <h3 class="product-name">{product.name}</h3>
              <span class="product-origin">
                <i class="fas fa-location-dot" aria-hidden="true"></i> {product.origin}
              </span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
