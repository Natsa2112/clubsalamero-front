---
import '../styles/plans.css';
---

<section class="section plans" id="planes">
  <div class="container">
    <h2 class="section-title">Elegí tu plan</h2>
    <p class="section-subtitle">Una suscripción para cada paladar. Tres niveles de variedad y exclusividad. Cancelás cuando quieras, sin letra chica.</p>
    <div class="plans-grid">
      <div class="plan-card">
        <div class="plan-header">
          <span class="plan-name">Esencial</span>
          <p class="plan-desc">La picada artesanal que descubre nuevos sabores cada mes.</p>
          <div class="plan-price">
            <span class="price">$59.900</span>
            <span class="price-period">/mes</span>
          </div>
          <span class="plan-varieties">4 variedades por mes</span>
        </div>
        <ul class="plan-features">
          <li><i class="fas fa-check"></i> 4 variedades de quesos y salames artesanales</li>
          <li><i class="fas fa-check"></i> Selección rotativa cada mes</li>
          <li><i class="fas fa-check"></i> Beneficios exclusivos en ferias</li>
          <li><i class="fas fa-check"></i> Acceso a recetas y maridajes exclusivos</li>
          <li><i class="fas fa-check"></i> Entrega refrigerada a convenir</li>
        </ul>
        <div class="plan-footer">
          <a href="#" class="btn btn-primary plan-btn">Elegir plan</a>
          <span class="plan-note">Sin permanencia · Cancelás cuando quieras</span>
        </div>
      </div>

      <div class="plan-card plan-featured">
        <div class="plan-badge">Selección del Club</div>
        <div class="plan-header">
          <span class="plan-name">Tradicional</span>
          <p class="plan-desc">La selección del Club. Variedad para compartir.</p>
          <div class="plan-price">
            <span class="price">$74.900</span>
            <span class="price-period">/mes</span>
          </div>
          <span class="plan-varieties">6 variedades por mes</span>
        </div>
        <ul class="plan-features">
          <li><i class="fas fa-check"></i> 6 variedades de quesos y salames artesanales</li>
          <li><i class="fas fa-check"></i> Selección rotativa cada mes</li>
          <li><i class="fas fa-check"></i> Acceso a regalos exclusivos</li>
          <li><i class="fas fa-check"></i> Beneficios exclusivos en ferias</li>
          <li><i class="fas fa-check"></i> Acceso a recetas y maridajes exclusivos</li>
          <li><i class="fas fa-check"></i> Entrega refrigerada a convenir</li>
        </ul>
        <div class="plan-footer">
          <a href="#" class="btn btn-primary plan-btn">Elegir plan</a>
          <span class="plan-note">Sin permanencia · Cancelás cuando quieras</span>
        </div>
      </div>

      <div class="plan-card">
        <div class="plan-header">
          <span class="plan-name">Gourmet</span>
          <span class="plan-premium">Premium</span>
          <p class="plan-desc">La experiencia más completa para sibaritas.</p>
          <div class="plan-price">
            <span class="price">$114.900</span>
            <span class="price-period">/mes</span>
          </div>
          <span class="plan-varieties">8 variedades por mes</span>
        </div>
        <ul class="plan-features">
          <li><i class="fas fa-check"></i> 8 variedades de quesos y salames artesanales</li>
          <li><i class="fas fa-check"></i> Selección especial cada mes</li>
          <li><i class="fas fa-check"></i> Un regalo exclusivo en cada box</li>
          <li><i class="fas fa-check"></i> Invitaciones a catas y eventos</li>
          <li><i class="fas fa-check"></i> Beneficios exclusivos en ferias</li>
          <li><i class="fas fa-check"></i> Acceso a recetas y maridajes exclusivos</li>
          <li><i class="fas fa-check"></i> Entrega refrigerada a convenir</li>
        </ul>
        <div class="plan-footer">
          <a href="#" class="btn btn-primary plan-btn">Elegir plan</a>
          <span class="plan-note">Sin permanencia · Cancelás cuando quieras</span>
        </div>
      </div>
    </div>
  </div>
</section>
