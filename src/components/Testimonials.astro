---
import '../styles/testimonials.css';
---

<section class="section testimonials" id="testimonios">
  <div class="container">
    <h2 class="section-title">Lo que dicen nuestros socios</h2>
    <div class="testimonials-slider" id="testimonials-slider">
      <div class="testimonial-track" id="testimonial-track">
        <div class="testimonial-card">
          <div class="testimonial-stars">
            <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
          </div>
          <blockquote>"La mejor picada que probé en mi vida. El packaging es impecable y todo llegó perfecto. Ya no puedo volver al salame del súper."</blockquote>
          <div class="testimonial-author">
            <div class="author-avatar">M</div>
            <div>
              <strong>Martín Gelberg</strong>
              <span>Suscriptor desde julio 2025</span>
            </div>
          </div>
        </div>
        <div class="testimonial-card">
          <div class="testimonial-stars">
            <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
          </div>
          <blockquote>"Increíble la calidad de los productos. Cada caja es una sorpresa distinta y la ficha de maridaje vale oro."</blockquote>
          <div class="testimonial-author">
            <div class="author-avatar">S</div>
            <div>
              <strong>Sebastián González</strong>
              <span>Suscriptor desde agosto 2025</span>
            </div>
          </div>
        </div>
        <div class="testimonial-card">
          <div class="testimonial-stars">
            <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
          </div>
          <blockquote>"Se lo regalé a mi viejo y terminamos los dos suscriptos. Productores que jamás hubiéramos descubierto solos."</blockquote>
          <div class="testimonial-author">
            <div class="author-avatar">N</div>
            <div>
              <strong>Noelia Matias</strong>
              <span>Suscriptora desde septiembre 2025</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="slider-dots" id="slider-dots">
      <span class="dot active" data-index="0"></span>
      <span class="dot" data-index="1"></span>
      <span class="dot" data-index="2"></span>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('testimonial-track');
    const dots = document.querySelectorAll('.dot');
    let currentIndex = 0;
    const totalSlides = dots.length;

    function goToSlide(index) {
      currentIndex = index;
      track.style.transform = `translateX(-${index * 100}%)`;
      dots.forEach(d => d.classList.remove('active'));
      dots[index].classList.add('active');
    }

    dots.forEach(dot => {
      dot.addEventListener('click', () => {
        goToSlide(parseInt(dot.dataset.index));
      });
    });

    setInterval(() => {
      goToSlide((currentIndex + 1) % totalSlides);
    }, 5000);
  });
</script>
